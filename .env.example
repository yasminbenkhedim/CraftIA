# CreateFlow AI — environment configuration template
#
# Copy this file to .env and fill in real values:
#   cp .env.example .env        (bash)
#   Copy-Item .env.example .env (PowerShell)
#
# NEVER commit .env — it holds live secrets (API keys, JWT signing key).
# .gitignore already excludes .env / .env.* / .env* ; this .example file is
# the only one meant to be committed.

# ── LLM provider (REQUIRED — the backend refuses to start without this) ────
# Groq API key. Free tier at https://console.groq.com/keys (starts with gsk_).
# The variable is named OPENAI_API_KEY for historical reasons (the project
# originally targeted an OpenAI-compatible Azure/PwC proxy before switching
# to Groq — see README "Key decisions"). It is read by the Groq provider at
# backend/app/services/llm/groq.py, not by OpenAI's own API.
OPENAI_API_KEY=YOUR_GROQ_API_KEY_HERE

# Model id on Groq. openai/gpt-oss-120b is the current default and is
# confirmed available on the free tier.
OPENAI_MODEL=openai/gpt-oss-120b

# Groq's OpenAI-compatible endpoint. Only change this if you switch provider.
OPENAI_BASE_URL=https://api.groq.com

# ── Database (pick ONE approach) ────────────────────────────────────────
# Simplest for local dev: point straight at a SQLite file. This is what
# start_backend.ps1 sets automatically, and what every example in this repo
# assumes.
DATABASE_URL=sqlite:///./createflow.db
#
# For a real Postgres instance instead: leave DATABASE_URL unset and fill in
# the POSTGRES_* vars below — the backend assembles a postgres:// URL from
# them at startup, and falls back to SQLite automatically if it can't
# connect (see backend/app/core/database.py:get_engine).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=createflow_db

# ── Auth (REQUIRED before any real user signs up) ───────────────────────
# Secret used to sign JWTs (backend/app/core/security.py). If left unset, a
# hardcoded fallback ships in the code — acceptable for a solo local test,
# never acceptable once the app has real accounts. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=YOUR_LONG_RANDOM_SECRET_HERE

# ── Stock footage (optional) ─────────────────────────────────────────────
# Pexels API key, free at https://www.pexels.com/api/. Without it, the
# Pexels stock-video/photo provider is skipped and Openverse (no key
# required) is used on its own.
PEXELS_API_KEY=YOUR_PEXELS_API_KEY_HERE

# ── Text-to-speech ───────────────────────────────────────────────────────
# 'kokoro' (local, Apache-2.0 weights — default) or 'edge' (Edge-TTS cloud,
# no key needed, used automatically as a fallback if Kokoro fails). XTTS and
# Piper are NOT valid values: both were removed for commercial-licence
# reasons — see LICENSES.md R1 and R6 and the README's "Key decisions".
TTS_ENGINE=kokoro
# Voice preset id and the matching espeak-ng language tag. These are the
# PROCESS-WIDE fallback used outside a real render (e.g. ab_test_voices.py);
# an actual video job resolves its own voice+language pair per request from
# the language the user picked — see agents/video/language.py.
KOKORO_VOICE=af_heart
KOKORO_LANG=en-us
KOKORO_MODEL_DIR=storage/models/kokoro
# KOKORO_SPEED=1.0

# ── Storage retention ────────────────────────────────────────────────────
# Days storage/artifacts/{job_id} directories are kept before the startup
# sweep deletes them. Code default if this is unset is 90; 0 (or negative)
# disables the sweep entirely. Recommended for local development, where
# your test renders ARE the working corpus rather than disposable output.
STORAGE_RETENTION_DAYS=0

# ── Admin / debug endpoints (optional — OFF unless set) ─────────────────
# Enables POST /api/me/admin/credits, used to test the credit system (force
# a balance, expire a period, change plan) without waiting a month. Leave
# UNSET in any shared or production environment: whoever holds this token
# can credit any account by email with no other authentication.
# CREDITS_ADMIN_TOKEN=

# Lets a request with no Authorization header fall back to a shared demo
# account instead of a 401. Convenient for a quick local UI check; never set
# this outside your own machine.
# ALLOW_DEV_ANONYMOUS_AUTH=0

# ── Advanced / optional providers (not required for the core MVP flow) ──
# These back optional generative-image and queue infrastructure that the
# current video/report/presentation pipeline does not require to run.
# Leave them unset unless you are specifically working on that provider.
# COMFYUI_HOST=
# COMFYUI_PORT=
# FLORA_API_KEY=
# REDIS_URL=redis://localhost:6379/0
# S3_ENDPOINT_URL=
